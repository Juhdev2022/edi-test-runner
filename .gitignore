# Ambiente virtual e cache Python
.venv/
__pycache__/
*.pyc

# Credenciais — nunca commitar
.env

# Docs de contexto/planejamento pessoal — não versionados
CONTEXTO_PROJETO_TESTRUNNER_PYTHON.md
PROMPT_CLAUDE_CODE_TESTRUNNER_PYTHON.md

# Dados gerados em runtime (execuções e reports)
data/execucoes/*
!data/execucoes/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Cobertura e cache de ferramentas
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
